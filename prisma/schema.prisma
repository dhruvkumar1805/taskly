// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  createdAt DateTime @default(now())

  tasks             Task[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Task {
  id                  String      @id @default(cuid())
  title               String
  description         String?
  priority            Priority    @default(MEDIUM)
  status              Status      @default(TODO)
  dueDate             DateTime?
  completedAt         DateTime?
  recurrence          Recurrence?
  // Set once this task's completion has spawned its next occurrence, so
  // toggling complete -> incomplete -> complete again on the same task
  // never spawns a second, duplicate successor.
  recurrenceCreatedAt DateTime?
  remindedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
}

enum Status {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Fixed-cadence repeat. On completion, the next occurrence is generated from
// the due date (not from the completion date) — see app/lib/recurrence.ts.
enum Recurrence {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  YEARLY
}
